{
    "app-id": "com.github.junrrein.PDFSlicer",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "pdfslicer",
    "finish-args": [
        "--filesystem=host",
        "--filesystem=xdg-run/gvfsd",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.gtk.vfs.*"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/intltool/intltool-0.51.json",
        "gtkmm.json",
        "poppler.json",
        {
            "name": "qpdf",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "cleanup": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/qpdf/qpdf.git",
                    "tag": "v12.4.1",
                    "commit": "c37f83ae468abb6cc741f43b2f6fdeb66e550ffb",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "pdfslicer",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/junrrein/pdfslicer.git",
                    "tag": "v1.8.8",
                    "commit": "c843e4b5bff170d920aaf36debd454d11ac6e03b",
                    "disable-shallow-clone": true,
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                },
                {
                    "type": "patch",
                    "paths": [
                        "patches/pdfslicer-range.patch",
                        "patches/pdfslicer-appdata.patch",
                        "patches/pdfslicer-prgname.patch",
                        "patches/pdfslicer-qpdf-11.patch",
                        "patches/pdfslicer-cxx20.patch"
                    ]
                },
                {
                    "type": "file",
                    "url": "https://github.com/catchorg/Catch2/releases/download/v2.13.8/catch.hpp",
                    "sha256": "f5adf6a4c3237920421d51a11112904084043b015acf2c9058e8f36b92ab2921",
                    "dest": "third-party/catch2/"
                }
            ]
        }
    ]
}
